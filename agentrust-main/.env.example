VITE_ZEROG_RPC_URL=https://evmrpc-testnet.0g.ai
VITE_ZEROG_CHAIN_ID=0x40da
VITE_ZEROG_NETWORK_NAME=0G Galileo Testnet
VITE_ZEROG_BLOCK_EXPLORER_URL=https://chainscan-galileo.0g.ai
# Optional: indexer file gateway base (no trailing /file). If unset, defaults to the 0G testnet indexer:
#   GET …/file?txSeq=…  or  …/file?root=0x…  (see https://docs.0g.ai/developer-hub/building-on-0g/storage/storage-cli )
# VITE_ZEROG_STORAGE_FILE_GATEWAY_URL=https://indexer-storage-testnet-turbo.0g.ai
# Optional: custom per-blob URL template — MUST include `{hash}` and/or `{seq}` placeholders (do not put a literal root hash in this value).
# VITE_ZEROG_STORAGE_EXPLORER_URL=https://storagescan-galileo.0g.ai/submission/{seq}

VITE_METADATA_UPLOAD_URL=/metadata/upload

VITE_AGENT_REGISTRY_ADDRESS=0x7534D403C84F874C930483270959E87f32f2c84a
# Redeploy contracts-0g/ValidationRegistry.sol after the public-submitter patch, then set the new address here.
VITE_VALIDATION_REGISTRY_ADDRESS=0xYourValidationRegistryAddress
VITE_STAKING_MANAGER_ADDRESS=0xYourStakingManagerAddress
VITE_TRUST_MANAGER_ADDRESS=0xYourTrustManagerAddress

ZEROG_EVM_RPC=https://evmrpc-testnet.0g.ai
ZEROG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
ZEROG_PRIVATE_KEY=your_storage_uploader_private_key

# Optional: real OpenClaw local runtime for generator + validator turns
OPENCLAW_RUNTIME_ENABLED=0
OPENCLAW_BIN=openclaw
OPENCLAW_PROFILE=agentrust
OPENCLAW_GENERATOR_MODEL=google/gemini-2.5-flash
OPENCLAW_VALIDATOR_MODEL=google/gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_for_openclaw_runtime

# 0G Compute Router — real validator inference (OpenAI-compatible). Get API key from pc.testnet.0g.ai
# ZEROG_COMPUTE_API_KEY=your_0g_compute_router_api_key
# ZEROG_COMPUTE_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
# ZEROG_COMPUTE_MODEL=qwen/qwen-2.5-7b-instruct
# Optional label shown in the UI for reasoning verification lanes
ZEROG_COMPUTE_LABEL=0G Compute validator lane
